{
	"name": "filenamify",
	"version": "6.0.0",
	"description": "Convert a string to a valid safe filename",
	"license": "MIT",
	"repository": "sindresorhus/filenamify",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": {
		"name": "Sindre Sorhus",
		"email": "sindresorhus@gmail.com",
		"url": "https://sindresorhus.com"
	},
	"main": "./dist/index.d.cjs",
	"module": "./dist/index.d.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsup",
		"test": "xo && ava && tsd"
	},
	"keywords": [
		"filename",
		"safe",
		"sanitize",
		"file",
		"name",
		"string",
		"path",
		"filepath",
		"convert",
		"valid",
		"dirname"
	],
	"type": "module",
	"devDependencies": {
		"ava": "^5.2.0",
		"tsd": "^0.28.1",
		"xo": "^0.54.1",
		"tsup": "^8.0.2",
		"typescript": "5.3.3"
	},
	"exports": {
		"import": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.d.js"
		},
		"require": "./dist/index.d.cjs"
	}
}
